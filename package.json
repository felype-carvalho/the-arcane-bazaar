{
    "homepage": "https://felype-carvalho.github.io/the-arcane-bazaar/",
    "name": "the-arcane-bazaar",
    "private": true,
    "version": "1.1.2",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build && node scripts/create-github-pages-fallback.mjs",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "browser:snapshot": "node --experimental-strip-types scripts/browser-snapshot.mts",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist"
    },
    "dependencies": {
        "@fontsource/cinzel": "^5.2.6",
        "@fontsource/inter": "^5.2.6",
        "i18next": "^26.5.12",
        "lucide-react": "^1.61.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-i18next": "^17.1.9",
        "react-router-dom": "^7.18.3"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.12",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.1.10",
        "@types/react-dom": "^19.1.7",
        "@vitejs/plugin-react": "^5.0.2",
        "fake-indexeddb": "^6.2.5",
        "gh-pages": "^6.3.0",
        "jsdom": "^26.1.0",
        "puppeteer-core": "^25.16.0",
        "tailwindcss": "^4.1.12",
        "typescript": "~5.8.3",
        "vite": "^7.1.3",
        "vitest": "^3.2.4"
    }
}
